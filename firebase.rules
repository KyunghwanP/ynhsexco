rules_version = '2';

// ══════════════════════════════════════════════════════════════
//  BIO-DATA 탐사대 — Firestore 보안 규칙
//  프로젝트: ynhs-exco
//
//  단계가 셋이다. 지금 쓸 블록 하나만 남기고 나머지 둘은 주석 처리한다.
//  바꾼 뒤 Firebase 콘솔 → Firestore → 규칙 → 게시 를 눌러야 적용된다.
//
//    1. 테스트   — 지금. 전부 열려 있다. 잘못 들어간 기록을 지울 수 있다
//    2. 실전     — 축전 전날 밤에 교체. 읽기·쓰기는 되고 삭제만 막는다
//    3. 종료 후  — 축전이 끝나면 교체. 전부 잠근다
//
//  apiKey 가 공개 저장소에 올라가 있는 것은 정상이다. 보안은 이 파일이 맡는다.
//  로그인이 없으므로 "실전" 단계에서도 누구나 읽고 쓸 수 있다.
//  막을 수 있는 것은 삭제뿐이다. 축전이 끝나면 반드시 3단계로 잠글 것.
//
//  컬렉션
//    records/{접수번호}  — 문진 + 측정값. 개인 기록
//    stats/live          — 이름·나이·번호 없이 값만 모은 분포.
//                          결과 조회 화면의 순위 계산에 쓴다.
//                          이 규칙이 빠지면 순위가 전부
//                          "자료를 더 모으는 중"으로 나오는데,
//                          집계 쓰기는 실패해도 조용해서 알아채기 어렵다
//    staff/roster        — 운영 학생 교대표 (staff.html). 방문객 기록과 무관하다.
//                          명단 + 시간표가 문서 하나에 통째로 들어 있다.
//                          이 규칙이 빠지면 교대표가 이 기기에만 남고
//                          다른 학생 폰에는 안 보인다. staff.html 은 그럴 때
//                          화면에 크게 띄운다 — 조용히 넘기면 다음 날 아침에 안다
// ══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── 1. 테스트 (현재 적용 중) ─────────
    match /records/{id} { allow read, write: if true; }
    match /stats/{id}   { allow read, write: if true; }
    match /staff/{id}   { allow read, write: if true; }

    // ───────── 2. 실전 — 축전 전날 밤 교체 ─────────
    // 위 세 줄을 주석 처리하고 아래 주석을 푼다.
    //
    // match /records/{id} {
    //   allow read: if true;
    //   allow create, update: if true;
    //   allow delete: if false;
    // }
    // match /stats/{id} {
    //   allow read: if true;
    //   allow create, update: if true;
    //   allow delete: if false;
    // }
    // match /staff/{id} {
    //   allow read: if true;
    //   allow create, update: if true;
    //   allow delete: if false;
    // }

    // ───────── 3. 종료 후 — 축전이 끝나면 교체 ─────────
    // CSV 를 먼저 내려받고 잠근다. 잠그면 결과 조회 QR 도 동작하지 않는다.
    //
    // match /records/{id} { allow read, write: if false; }
    // match /stats/{id}   { allow read, write: if false; }
    // match /staff/{id}   { allow read, write: if false; }

    // 그 밖의 경로는 언제나 막는다.
    // Firestore 규칙은 하나라도 허용하면 통과시키므로,
    // 이 줄이 위의 records·stats·staff 허용을 되돌리지는 않는다.
    match /{document=**} { allow read, write: if false; }
  }
}
